// Reference pipeline for linting.md.
// Reduced to the shape: an overridden step, a builtin used bare, one all-files step,
// and the hooks they compose into.
amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// No step names a config on the command line.
// Each tool reaches its config under .config/ by the ladder in repo-layout.md,
// so a flag here would fix only hk's call sites and leave an interactive run on defaults.

// Files the repo does not own — app-managed, or emitted by a vendor's generator.
// Output from a generator the repo owns is absent:
// that is linted like any other file.
// Declared once so a new exclusion cannot be missed at one call site.
local notOurs = List(
  "gh/hosts.yml",     // gh writes this
  "docs/TASKS.md"     // `mise generate task-docs` emits this
)

local rumdl = (Builtins.rumdl) {
  exclude = notOurs
}

// Secret scanning takes no exclude list: it must see every committed line.
// `git` mode reads blobs from history, so untracked and gitignored trees are
// structurally invisible rather than walked and skipped.
local gitleaks = (Builtins.gitleaks) {
  check = "gitleaks git --redact --no-banner ."
}

local formatters = new Mapping<String, Step> {
  ["rumdl"] = rumdl
}

local linters = new Mapping<String, Step> {
  // No override: SHELLCHECK_OPTS carries the rcfile, and the builtin already
  // matches an extensionless script by its shebang, so neither the config nor
  // the glob needs restating here.
  ["shellcheck"] = Builtins.shellcheck
}

// Hooks compose the same mappings rather than relisting steps,
// so a step added above reaches every hook that should run it.
hooks {
  ["pre-commit"] {
    fix = true
    // Fixes land in the working tree and block the commit;
    // nothing reaches a commit that was not read and staged by hand.
    stage = false
    fail_on_fix = true
    stash = "git"
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
    }
  }
  ["pre-push"] {
    steps = new Mapping<String, Step> {
      ["gitleaks"] = gitleaks
    }
  }
  ["check"] {
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
      ["gitleaks"] = gitleaks
    }
  }
  ["fix"] {
    fix = true
    // No `stage` here: only pre-commit stages by default,
    // so these fixes land in the working tree and are staged by hand.
    steps = new Mapping<String, Step> {
      ...formatters
    }
  }
}
