// Reference pipeline for linting.md.
// Reduced to the shape: two owned steps, one all-files step, and the hooks they compose into.
amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Builtins.pkl"

// Files the repo does not own — app-managed or generated.
// Declared once so a new exclusion cannot be missed at one call site.
local notOurs = List(
  "gh/hosts.yml",     // gh writes this
  "docs/TASKS.md"     // generated by catalog:tasks
)

// Extensionless task and hook scripts are shell too,
// so the builtin's "**/*.sh" glob is widened rather than accepted.
local shellGlob = List("**/*.sh", ".config/mise/tasks/**")

local shellcheck = (Builtins.shellcheck) {
  glob = shellGlob
  exclude = notOurs
  check = "shellcheck --rcfile .config/shellcheckrc {{ files }}"
}

local rumdl = (Builtins.rumdl) {
  exclude = notOurs
  check_diff = "rumdl check --config .config/rumdl.toml --diff {{ files }}"
  fix = "rumdl check --config .config/rumdl.toml --fix {{ files }}"
}

// Secret scanning takes no exclude list: it must see every committed line.
// `git` mode reads blobs from history, so untracked and gitignored trees are
// structurally invisible rather than walked and skipped.
local gitleaks = (Builtins.gitleaks) {
  check = "gitleaks git --redact --no-banner ."
}

local formatters = new Mapping<String, Step> {
  ["rumdl"] = rumdl
}

local linters = new Mapping<String, Step> {
  ["shellcheck"] = shellcheck
}

// Hooks compose the same mappings rather than relisting steps,
// so a step added above reaches every hook that should run it.
hooks {
  ["pre-commit"] {
    fix = true
    // Fixes land in the working tree and block the commit;
    // nothing reaches a commit that was not read and staged by hand.
    stage = false
    fail_on_fix = true
    stash = "git"
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
    }
  }
  ["pre-push"] {
    steps = new Mapping<String, Step> {
      ["gitleaks"] = gitleaks
    }
  }
  ["check"] {
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
      ["gitleaks"] = gitleaks
    }
  }
  ["fix"] {
    fix = true
    steps = new Mapping<String, Step> {
      ...formatters
    }
  }
}
