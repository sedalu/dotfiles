// Reference config for dependencies.md.
// Reduced to the shape: a version no manager reads,
// the rule that keeps it with the tool it belongs to,
// and the merge policy that makes an unattended bump safe.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Renovate arms the forge's own "merge when checks succeed"
  // as it opens the pull request,
  // so a branch with no required check has nothing to wait on
  // and merges the moment it is created.
  platformAutomerge: true,

  // An hk pipeline names its schema by URL,
  // and `amends` and `import` each need a literal,
  // so the version cannot be declared once and referenced.
  // Both lines carry it twice,
  // once in the release path,
  // once in the package coordinate.
  // Renovate confirms a replacement by the dependency's extracted index,
  // so two match strings reach all four occurrences.
  //
  // The templates copy what the real manager derives for the same tool,
  // read out of Renovate rather than inferred:
  // mise installs hk from `packslip:github.com/jdx/hk`,
  // while Renovate matches the name in its own static table,
  // and resolves it against GitHub releases.
  // Copying the wrong one leaves the two halves tracking different version streams.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)hk\\.pkl$/"],
      matchStrings: [
        "download/v(?<currentValue>[^/]+)/hk@",
        "/hk@(?<currentValue>[^#]+)#",
      ],
      depNameTemplate: "hk",
      packageNameTemplate: "jdx/hk",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>\\S+)",
    },
  ],

  packageRules: [
    {
      // The binary and the pkl package it evaluates are one version in two files.
      // Split across two pull requests they deadlock:
      // whichever merges first breaks the check the other one needs to pass.
      matchDepNames: ["hk"],
      groupName: "hk",
    },
    {
      // Linters and formatters — none of them reach a host,
      // and ci exercises all of them.
      // That check passing is the entire safety argument for merging unattended.
      //
      // The prefix is named rather than derived,
      // which also leaves the subject's capitalization alone.
      // Every manager in use needs the same rule,
      // or the history carries a bump typed two ways and cased two ways.
      matchManagers: ["mise", "custom.regex"],
      matchUpdateTypes: ["minor", "patch"],
      commitMessagePrefix: "chore(deps):",
      automerge: true,
    },
    {
      // A major bump gets a human reading its changelog.
      matchManagers: ["mise", "custom.regex"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "chore(deps):",
      automerge: false,
    },
  ],
}
