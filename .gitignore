# Go config dir — the env file is rendered from go/env.tmpl by mise [dotfiles];
# track the template, ignore the rendered env file and everything else
/go/*
!/go/env.tmpl
/.git
/shell/zsh/.zsh_sessions/
/claude/projects/

# fnox secrets — deny-by-default (age private keys live here); track only config
/fnox/*
!/fnox/config.toml

# Homebrew's XDG config dir — nothing here is ours; ignore anything brew drops
/homebrew/

# Colima runtime state (VM disk images, sockets) — not config
/colima/

# npm userconfig — deny-by-default; npm writes auth tokens to .npmrc
/npm/
