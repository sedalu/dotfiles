[user]
    name = Seth Lumnah
    email = seth.lumnah@boldlygo.dev
    signingkey = ~/.ssh/id_ed25519.pub
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers
[commit]
    gpgSign = true
[tag]
    gpgSign = true
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
[init]
    defaultBranch = main
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = false
    dark = true
    syntax-theme = Dracula
    line-numbers = true
    hunk-header-style = syntax
    minus-style = syntax "#45213b"
    minus-emph-style = syntax "#7d2e4a"
    plus-style = syntax "#1f3a36"
    plus-emph-style = syntax "#2d5a52"
    line-numbers-minus-style = "#f38ba8"
    line-numbers-plus-style = "#a6e3a1"
    line-numbers-zero-style = "#6c7086"
[merge]
    conflictStyle = zdiff3
[diff]
    colorMoved = default
[alias]
    co = checkout
    br = branch
    st = status
    lg = log --oneline --graph --decorate
    unstage = reset HEAD --
    amend = commit --amend --no-edit
[hook "hk-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run commit-msg --from-hook \"$@\"
	event = commit-msg
[hook "hk-post-checkout"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run post-checkout --from-hook \"$@\"
	event = post-checkout
[hook "hk-post-commit"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run post-commit --from-hook \"$@\"
	event = post-commit
[hook "hk-post-merge"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run post-merge --from-hook \"$@\"
	event = post-merge
[hook "hk-post-rewrite"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run post-rewrite --from-hook \"$@\"
	event = post-rewrite
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run pre-commit --from-hook \"$@\"
	event = pre-commit
[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run pre-push --from-hook \"$@\"
	event = pre-push
[hook "hk-pre-rebase"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run pre-rebase --from-hook \"$@\"
	event = pre-rebase
[hook "hk-prepare-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || mise x -- hk run prepare-commit-msg --from-hook \"$@\"
	event = prepare-commit-msg
