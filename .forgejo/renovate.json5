// Only the hk pipeline's own pins in .config/mise/ are managed here.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // main requires `ci / ci (pull_request)`,
  // so the forge has a check to wait on
  // and merges when ci reports rather than when Renovate next runs.
  //
  // Renovate merges under its own account,
  // allowed only because the rule enables no merge whitelist
  // (models/git/protected_branch.go, IsUserMergeWhitelisted falls back to write permission).
  // Adding one without `renovate` on it leaves every pull request green and unmerged.
  platformAutomerge: true,
  // No `labels:` anywhere below, deliberately.
  // Renovate's Forgejo platform resolves label names to IDs against the repo
  // and silently drops whatever it cannot find,
  // so an entry naming a label that does not exist is a no-op
  // that reads like a working rule.
  // This forge defines none, on this repo or the org.
  //
  // hk's pkl package version is a pin no manager reads.
  // `amends` and `import` each need a literal URL,
  // so the version cannot be declared once and referenced,
  // and both lines carry it twice —
  // once in the release path,
  // once in the package coordinate.
  // Renovate confirms a replacement by the dependency's extracted index,
  // so it walks to the occurrence belonging to the upgrade in hand,
  // and two match strings reach all four.
  //
  // The templates copy what the mise manager derives for the `hk` tool entry.
  // That is not the backend mise installs from:
  // mise resolves the bare name through the registry to `packslip:github.com/jdx/hk`,
  // while Renovate matches `hk` in its own static tooling table
  // (modules/manager/mise/upgradeable-tooling.ts),
  // and never consults the registry.
  // Copy that table's values,
  // rather than deriving them from the backend,
  // or the two halves of the pin track different version streams.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)hk\\.pkl$/"],
      matchStrings: [
        "download/v(?<currentValue>[^/]+)/hk@",
        "/hk@(?<currentValue>[^#]+)#",
      ],
      depNameTemplate: "hk",
      packageNameTemplate: "jdx/hk",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>\\S+)",
    },
  ],
  packageRules: [
    {
      // mise/ is the workstation toolchain this repo ships —
      // it installs to $XDG_CONFIG_HOME/mise/,
      // and is the artifact rather than tooling for the artifact.
      // Renovate's default patterns match it on path shape alone,
      // and every entry in it tracks `latest` by design.
      // Left enabled, each one reaches a datasource lookup
      // that can never produce a bump.
      matchFileNames: ["mise/config*.toml"],
      enabled: false,
    },
    {
      // The binary and the pkl package it evaluates are one pin in two files.
      // A config amending one major does not evaluate under a binary of the other —
      // hk 2 reads a v1 package as `union property 'command' has no selected default` —
      // so a pull request carrying only one half is a broken pipeline.
      // Grouping them means neither can merge alone.
      matchDepNames: ["hk"],
      groupName: "hk",
    },
    {
      // Linters, formatters, and actions — none of them reach a host,
      // and ci exercises all of them.
      // That check passing is the entire safety argument for merging unattended.
      matchManagers: ["mise", "github-actions", "custom.regex"],
      matchUpdateTypes: ["minor", "patch"],
      commitMessagePrefix: "chore(deps):",
      automerge: true,
    },
    {
      // A major bump gets a human reading its changelog.
      matchManagers: ["mise", "github-actions", "custom.regex"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "chore(deps):",
      automerge: false,
    },
  ],
}
