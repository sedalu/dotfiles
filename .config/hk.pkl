amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Builtins.pkl"

// Files we don't own — app-managed or generated.
// Formatters, hygiene *fixes*, and linters skip these
// (they'd fight the owning app or churn generated output).
// Secret scanners and non-destructive guards deliberately do NOT use this list:
// they must see every staged/pushed file.
local notOurs = List(
  "gh/hosts.yml",           // gh writes this; holds auth tokens
  "gh/config.yml",          // gh-managed
  "claude/settings.json",   // Claude / update-config skill writes this
  "claude/settings.local.json",
  "claude/MEMORY.md",       // Claude auto-memory index (global)
  "claude/memory/**",       // Claude auto-memory (global)
  ".claude/memory/**",      // Claude auto-memory (this repo's project memory)
  "obsidian/**",            // obsidian-git plugin data
  "cmux/**",                // cmux app config
  "docs/TASKS.md"           // generated by catalog:tasks
)

// Our shell scripts include many extensionless files (bin/, mise tasks/hooks),
// so the builtin "**/*.sh" globs aren't enough.
// zsh is intentionally absent: shfmt/shellcheck don't support it.
local shellGlob = List(
  "**/*.sh",
  "**/*.bash",
  "bin/**",
  ".config/mise/tasks/**",
  "mise/tasks/**",
  "mise/hooks/**",
  "shell/bash/**",
  "docs/dev-standards/examples/mise-task-check-all"
)

// --- Owned-only linters (check, no fix) ---
local shellcheck = (Builtins.shellcheck) {
  glob = shellGlob
  exclude = notOurs
  check = "shellcheck --rcfile .config/shellcheckrc {{ files }}"
}
local taplo = (Builtins.taplo) { exclude = notOurs }

// --- Owned-only formatters/fixers (have a fix command) ---
local shfmt = (Builtins.shfmt) {
  glob = shellGlob
  exclude = notOurs
}
local taploFormat = (Builtins.taplo_format) { exclude = notOurs }
local rumdl = (Builtins.rumdl) {
  exclude = notOurs
  check_diff = "rumdl check --config .config/rumdl.toml --diff {{ files }}"
  fix = "rumdl check --config .config/rumdl.toml --fix {{ files }}"
}
// yamlfmt is the YAML *formatter* only;
// ryl (below) owns linting, replacing yamlfmt's `-lint` pass.
// Dropping check_diff leaves yamlfmt with no check command,
// so hk skips it in check runs and only formats in fix/pre-commit runs.
local yamlfmt = (Builtins.yamlfmt) {
  exclude = notOurs
  check_diff = null
  fix = "yamlfmt -conf .config/yamlfmt.yml {{ files }}"
}
// ryl is the YAML *linter* (replaces `yamlfmt -lint`).
// Config lives in .config/ryl.toml, passed explicitly:
// ryl would discover it, but hk's other tools pass their .config/ sidecars the same way.
// Plain `ryl check` (not --diff) so unfixable violations fail too, not just fixable drift.
local ryl = (Builtins.ryl) {
  exclude = notOurs
  check = "ryl check -c .config/ryl.toml {{ files }}"
  check_diff = null
  check_list_files = null
  fix = "ryl check -c .config/ryl.toml --fix {{ files }}"
}
local typos = (Builtins.typos) {
  exclude = notOurs
  check_diff = """
    output=$(typos --force-exclude --config .config/typos.toml --diff {{ files }})
    [ -z "$output" ] && exit 0
    printf "%s" "$output"
    exit 1
    """
  fix = "typos --force-exclude --config .config/typos.toml --write-changes {{ files }}"
}
local newlines = (Builtins.newlines) { exclude = notOurs }
local mixedLineEnding = (Builtins.mixed_line_ending) { exclude = notOurs }
local trailingWhitespace = (Builtins.trailing_whitespace) { exclude = notOurs }

// --- Non-destructive guards + secret scanning: ALL files (no exclude) ---
local guards = new Mapping<String, Step> {
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_added_large_files"] = Builtins.check_added_large_files
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  ["check_symlinks"] = Builtins.check_symlinks
  ["detect_private_key"] = Builtins.detect_private_key
}

// Secret scanner — `git` mode, not the builtin's `dir` mode.
// `gitleaks dir` walks the filesystem:
// it ignores .gitignore, follows into untracked siblings,
// and (given many path args) falls back to scanning `.` —
// which drags in the multi-GB gitignored trees living under our worktree
// (colima/ VM state, claude/ runtime data).
// `gitleaks git` reads blobs straight from git history,
// so gitignored/untracked/symlinked files are structurally invisible
// while every committed line we own is scanned.
// Fast (~100ms over full history) and exact.
local gitleaks = (Builtins.gitleaks) {
  check = "gitleaks git --redact --no-banner ."
}

// Owned formatters (run fix + restage in fix hooks).
local formatters = new Mapping<String, Step> {
  ["newlines"] = newlines
  ["mixed_line_ending"] = mixedLineEnding
  ["trailing_whitespace"] = trailingWhitespace
  ["shfmt"] = shfmt
  ["taplo_format"] = taploFormat
  ["rumdl"] = rumdl
  ["yamlfmt"] = yamlfmt
  ["ryl"] = ryl
  ["typos"] = typos
}

// Owned check-only linters.
local linters = new Mapping<String, Step> {
  ["shellcheck"] = shellcheck
  ["taplo"] = taplo
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = false
    fail_on_fix = true
    stash = "git"
    steps = new Mapping<String, Step> {
      ...guards
      ...formatters
      ...linters
    }
  }
  ["commit-msg"] {
    steps = new Mapping<String, Step> {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
    }
  }
  ["pre-push"] {
    steps = new Mapping<String, Step> {
      ["gitleaks"] = gitleaks
    }
  }
  ["check"] {
    steps = new Mapping<String, Step> {
      ...guards
      ...formatters
      ...linters
      ["gitleaks"] = gitleaks
    }
  }
  ["fix"] {
    fix = true
    steps = new Mapping<String, Step> {
      ...formatters
    }
  }
}
