#!/usr/bin/env bash
#USAGE complete "Regenerate the task reference in docs/TASKS.md"
#MISE description="Regenerate the task reference in docs/TASKS.md"
#MISE sources=[".config/mise/tasks/**/*"]
#MISE outputs=["docs/TASKS.md"]
set -euo pipefail

# Regenerate the full task reference from each task's Usage spec,
# injecting it between the <!-- mise-tasks --> / <!-- /mise-tasks --> markers in TASKS.md.
# The curated at-a-glance table in README.md is maintained by hand;
# this is the complete, always-current listing.
# sources/outputs let mise skip the regen when no task file has changed.
DOC="$DOTFILES_DIR/docs/TASKS.md"

mise generate task-docs --style detailed --inject --output "$DOC"

echo "📋 Wrote task reference to ${DOC#"$DOTFILES_DIR"/}"
