#!/usr/bin/env bash
#MISE description="Check zsh plugins are installed (soft warning)"
#MISE depends=["doctor:dirs"]
#MISE hide=true
set -euo pipefail

# [bootstrap.repos] hardcodes the XDG default;
# catch XDG_DATA_HOME drifting away from it.
declared="$HOME/.local/share/zsh/plugins"
sourced="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
if [[ "$sourced" != "$declared" ]]; then
	echo "⚠️ .zshrc loads plugins from $sourced, but [bootstrap.repos] clones to $declared"
fi

if ! mise bootstrap repos status --missing; then
	echo "⚠️ plugin(s) not in their declared state — run mise run install:zsh-plugins"
fi

exit 0
