#!/usr/bin/env bash
#MISE description="Check [dotfiles] symlinks point to correct targets"
#MISE depends=["doctor:repo"]
#MISE hide=true
set -euo pipefail

# Hard gate: every entry in [dotfiles] must be applied
# (symlink present and pointing at the declared source).
# `status --missing` exits 1 on any drift — missing, source missing, or differs.
if mise dotfiles status --missing; then
	echo "✅ All [dotfiles] symlinks correct"
else
	echo "❌ Symlinks out of sync — run mise run install:symlinks"
	exit 1
fi
