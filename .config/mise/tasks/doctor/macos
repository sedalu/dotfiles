#!/usr/bin/env bash
#MISE description="Check macOS defaults match tracked settings"
#MISE hide=true
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
	echo "⏭️  Not macOS, skipping"
	exit 0
fi

# shellcheck source=SCRIPTDIR/../../../../lib/dotfiles/macos.sh
source "$DOTFILES_DIR/lib/dotfiles/macos.sh"

fail=0

# --- Preferences: gate on mise's own status ---
# `status --missing` prints a desired/current/state table
# and exits 1 if any [bootstrap.macos.defaults] value drifts.
echo "🔧 Preferences ([bootstrap.macos.defaults]):"
if mise bootstrap macos-defaults status --missing; then
	echo "✅ All preferences correct"
else
	echo "❌ Preferences out of sync — run 'mise run install:macos'"
	fail=1
fi

# --- Reset-catalog: each tracked key must be absent ---
echo "🧹 Reset-catalog (macos/settings.sh):"
_dw_domains=() _dw_keys=()
while IFS= read -r file; do
	macos_parse_defaults "$file"
done < <(macos_settings_files)

cat_fail=0
for i in "${!_dw_domains[@]}"; do
	domain="${_dw_domains[$i]}"
	key="${_dw_keys[$i]}"
	if current="$(defaults read "$domain" "$key" 2>/dev/null)"; then
		echo "❌ $domain $key = $current (expected: deleted)"
		((cat_fail++)) || true
	fi
done

if ((cat_fail > 0)); then
	echo "❌ $cat_fail catalog key(s) still set — run 'mise run install:macos'"
	fail=1
else
	echo "✅ All catalog keys at macOS default"
fi

if ((fail > 0)); then
	exit 1
fi
echo "✅ All macOS settings correct"
