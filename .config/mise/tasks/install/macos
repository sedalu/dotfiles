#!/usr/bin/env bash
#MISE description="Apply macOS defaults settings"
#MISE hide=true
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
	echo "⏭️  Not macOS, skipping"
	exit 0
fi

# --- Step 1: scalar preferences via [bootstrap.macos.defaults] ---
# Capture which write-domains mise will change *before* applying,
# so we can restart exactly those apps afterwards.
# status columns are space-padded;
# the domain is the first field and the state the last,
# so first/last extraction is robust to value spacing — no jq needed.
write_changed=()
while read -r domain; do
	[[ -n "$domain" ]] && write_changed+=("$domain")
done < <(mise bootstrap macos-defaults status 2>/dev/null | awk '$NF != "set" { print $1 }')

# mise prints what it writes and stays quiet when nothing changes — no banner of our own.
mise bootstrap macos-defaults apply --yes

# --- Step 2: reset-catalog via `defaults delete` ---
# These keys have no [bootstrap.macos.defaults] equivalent
# (mise can't express "absent"),
# so they stay as sourced `defaults delete` lines.

# Wrap `defaults` while sourcing the catalog so we report only the keys that actually change —
# a `defaults delete` of an already-absent key is a no-op (and may "fail"), and stays silent.
# Each changed key's domain is recorded so Step 3 restarts exactly the affected apps,
# which folds the old before/after snapshot into this single pass.
delete_changed=()
defaults() {
	local domain="$2" key="$3" before after
	before="$(command defaults read "$domain" "$key" 2>/dev/null || true)"
	command defaults "$@" 2>/dev/null || true
	after="$(command defaults read "$domain" "$key" 2>/dev/null || true)"
	[[ "$before" == "$after" ]] && return 0
	echo "  ✔ ${*:2}"
	delete_changed+=("$domain")
}

killall_targets=()
# shellcheck source=SCRIPTDIR/../../../../lib/dotfiles/macos-settings.sh
. "$DOTFILES_DIR/lib/dotfiles/macos-settings.sh"

machine_file="$DOTFILES_DIR/lib/dotfiles/macos-settings.${DOTFILES_MACHINE}.sh"
if [[ -f "$machine_file" ]]; then
	echo "  📎 Machine: $DOTFILES_MACHINE"
	# shellcheck source=/dev/null
	. "$machine_file"
fi

unset -f defaults

# --- Step 3: restart only the apps whose settings changed ---
# write_changed (Step 1) and delete_changed (built by the wrapper above) name the changed domains.
_needed_targets=()
_has_target() {
	local t
	for t in "${_needed_targets[@]}"; do [[ "$t" == "$1" ]] && return 0; done
	return 1
}

for domain in "${write_changed[@]}" "${delete_changed[@]}"; do
	for entry in "${killall_targets[@]}"; do
		[[ "${entry%%:*}" == "$domain" ]] || continue
		target="${entry#*:}"
		_has_target "$target" || _needed_targets+=("$target")
	done
done

if ((${#_needed_targets[@]} > 0)); then
	echo "🔄 Restarting changed apps..."
	for target in "${_needed_targets[@]}"; do
		killall "$target" 2>/dev/null || true
		echo "  ↺ $target"
	done
fi

# Stay silent when nothing changed; only speak up when something was actually applied.
if ((${#write_changed[@]} + ${#delete_changed[@]} > 0)); then
	# A killall covers most apps, but some settings still need a logout/reboot.
	echo "🎉 macOS settings applied"
	echo "ℹ️  Some settings may require logout or reboot to take effect"
fi
