#!/usr/bin/env bash
#USAGE complete "Update mise managed tools"
#MISE description="Update mise managed tools"
#MISE hide=true

set -euo pipefail

# --- update -----------------------------

# No banners of our own — each mise subcommand prints its own outcome
# (e.g. "mise is already up to date") and stays quiet when there's nothing to do.
mise self-update --yes
mise plugins update --yes
mise upgrade --bump --yes

# System packages declared in [bootstrap.packages] (poured Homebrew bottles).
mise bootstrap packages upgrade --yes

# --- environment ------------------------

# completions stays silent on success and only speaks up on failure.
"$DOTFILES_DIR/mise/hooks/completions" --tool mise completions {}
