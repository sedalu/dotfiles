#!/usr/bin/env bash
#USAGE complete "Update mise managed tools"
#MISE description="Update mise managed tools"
#MISE hide=true
# raw=true: pkg-cask upgrades (e.g. tailscale-app) may need a sudo prompt,
# which needs a real TTY —
# the `update` aggregator's prefixing otherwise pipes stdio and hides it.
#MISE raw=true

set -euo pipefail

# --- update -----------------------------

# No banners of our own — each mise subcommand prints its own outcome
# (e.g. "mise is already up to date") and stays quiet when there's nothing to do.
mise self-update --yes
mise plugins update --yes
mise upgrade --bump --yes

# System packages declared in [bootstrap.packages] (poured Homebrew bottles).
#
# pkgconf ships bin/pkg-config and lib/libpkgconf.dylib as symlinks to siblings inside its own keg.
# mise mishandles that second symlink hop and refuses to relink them, aborting the whole upgrade —
# but only once pkgconf has a new bottle to pour.
# Clear just those two symlinks first, and only when a pour is pending.
if mise bootstrap packages upgrade --dry-run --yes brew:pkgconf 2>&1 | grep -q '^pour pkgconf/'; then
	for f in /opt/homebrew/bin/pkg-config /opt/homebrew/lib/libpkgconf.dylib; do
		[[ -L "$f" ]] || continue
		case "$(readlink "$f")" in
		../Cellar/pkgconf/*) rm -f "$f" ;;
		esac
	done
fi
mise bootstrap packages upgrade --yes

# --- environment ------------------------

# completions stays silent on success and only speaks up on failure.
"$DOTFILES_DIR/mise/hooks/completions" --tool mise completions {}
