#!/usr/bin/env bash
#MISE description="Update dotfiles"
set -euo pipefail

# --- sync -------------------------------

# The pull's post-merge hook installs any newly pinned hk through `mise x`,
# which trusts cached GitHub release data however old it is.
mise cache clear --quiet github

# Pull first, so the subtasks run against the latest config.
if ! git pull --ff-only; then
	echo "⚠️ Could not fast-forward $DOTFILES_DIR; updating from the local checkout." >&2
fi

# --- update -----------------------------

# Prefix each parallel subtask's output with its task name for attribution.
# The persisted task.output setting is ignored by `mise run` (mise 2026.6.10),
# so force it via the env var here.
# Leave installing to update:mise, which refreshes the release cache first.
MISE_TASK_OUTPUT=prefix MISE_TASK_RUN_AUTO_INSTALL=false mise run update:mise ::: update:macos ::: update:zsh-plugins
