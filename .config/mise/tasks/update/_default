#!/usr/bin/env bash
#MISE description="Update dotfiles"
set -euo pipefail

# --- sync -------------------------------

# Pull first, so the subtasks run against the latest config.
if ! git pull --ff-only; then
	echo "⚠️ Could not fast-forward $DOTFILES_DIR; updating from the local checkout." >&2
fi

# --- update -----------------------------

# Prefix each parallel subtask's output with its task name for attribution.
# The persisted task.output setting is ignored by `mise run` (mise 2026.6.10),
# so force it via the env var here.
MISE_TASK_OUTPUT=prefix mise run update:mise ::: update:macos ::: update:zsh-plugins
