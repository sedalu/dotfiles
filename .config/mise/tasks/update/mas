#!/usr/bin/env bash
#USAGE complete "Update App Store apps via mas"
#MISE description="Update App Store apps via mas"
#MISE hide=true

set -euo pipefail

[[ "${DOTFILES_OS:-}" != "darwin" ]] && exit 0

# --- update -----------------------------

# Check first so the password heads-up (and mas's own progress banners)
# only show up when there's actually an update to install.
outdated="$(mas outdated)"

if [[ -n "${outdated}" ]]; then
	# macOS can prompt for your login password to authorize the install
	# with no warning of its own — flag it before mas starts.
	echo "🔐 macOS may prompt for your password to authorize the update..."
fi

# mas prints "Update progress cannot be displayed" with no trailing newline,
# so the next "==> Updated …" line runs into it — insert the missing newline.
mas upgrade | sed -l 's/cannot be displayed==>/cannot be displayed\n==>/g'
