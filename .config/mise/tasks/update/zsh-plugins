#!/usr/bin/env bash
#USAGE complete "Update zsh plugins"
#MISE description="Update zsh plugins"
#MISE hide=true

set -euo pipefail

# --- config -----------------------------

# Zsh plugins directory.
ZSH_PLUGINS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

# --- update -----------------------------

if [[ ! -d "$ZSH_PLUGINS_DIR" ]]; then
	echo "🛑 Error: $ZSH_PLUGINS_DIR does not exist. Run 'mise run install:zsh-plugins' first." >&2
	exit 1
fi

failed=0

# Report only the plugins that actually moved or failed —
# a no-op pull (the common case) stays silent.
# Compare HEAD before/after rather than scraping git's "Already up to date." text.
for dir in "$ZSH_PLUGINS_DIR"/*/; do
	[[ -d "$dir/.git" ]] || continue
	name=$(basename "$dir")
	before=$(git -C "$dir" rev-parse HEAD)
	if out=$(git -C "$dir" pull --rebase --autostash 2>&1); then
		after=$(git -C "$dir" rev-parse HEAD)
		[[ "$before" != "$after" ]] && echo "✅ $name updated."
	else
		echo "⚠️ Failed to update $name." >&2
		echo "$out" >&2
		failed=$((failed + 1))
	fi
done

if [[ $failed -gt 0 ]]; then
	exit 1
fi
