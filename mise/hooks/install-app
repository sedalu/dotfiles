#!/usr/bin/env bash
#USAGE about "Mount a DMG from the mise install path and copy the .app bundle to ~/Applications."
#USAGE flag "--path <path>" help="Directory containing the DMG (default: $MISE_TOOL_INSTALL_PATH)."
#USAGE flag "--app <name>" help="Name of the .app bundle to install (default: first .app found on the volume)."
#USAGE flag "--dest <dir>" help="Destination directory for the .app bundle (default: ~/Applications)."
#USAGE flag "--force" help="Install even when the destination holds this version or newer, or the app is running."
set -euo pipefail

# --- config -----------------------------

# Directory containing the DMG, resolved from --path flag or $MISE_TOOL_INSTALL_PATH.
path=""
# Name of the .app bundle (without .app suffix), resolved from --app flag.
app=""
# Destination directory for the installed .app bundle.
dest=""
# Bypass the version and running-app guards.
force="false"

while [[ $# -gt 0 ]]; do
	case "$1" in
	--path)
		path="${2:?--path requires a value}"
		shift 2
		;;
	--app)
		app="${2:?--app requires a value}"
		shift 2
		;;
	--dest)
		dest="${2:?--dest requires a value}"
		shift 2
		;;
	--force)
		force="true"
		shift
		;;
	*)
		echo "🛑 Error: unknown argument: $1" >&2
		exit 1
		;;
	esac
done

# Resolve final values: CLI flag takes precedence over environment variable.
path="${path:-${MISE_TOOL_INSTALL_PATH:-}}"
dest="${dest:-$HOME/Applications}"

if [[ -z "$path" ]]; then
	echo "🛑 Error: --path or \$MISE_TOOL_INSTALL_PATH must be set." >&2
	exit 1
fi

echo "⚙️ Configuring..."
echo "→ path=$path"
echo "→ app=${app:-(auto)}"
echo "→ dest=$dest"
echo "→ force=$force"

# --- helpers ----------------------------

# Print a bundle's CFBundleShortVersionString, or nothing when it can't be read.
# PlistBuddy reports a missing file or key on stdout rather than stderr,
# so accept only a version-shaped result and treat anything else as unknown.
# An unknown version disables the comparison guards, which then fall through to installing.
bundle_version() {
	local plist="$1/Contents/Info.plist" version=""

	if [[ -f "$plist" ]]; then
		version="$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$plist" 2>/dev/null || true)"
	fi
	if [[ "$version" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
		printf '%s' "$version"
	fi
	return 0
}

# True when $1 is a strictly newer version than $2.
version_gt() {
	[[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]
}

# --- install ----------------------------

# Skip on non-macOS — .app bundles are macOS-only.
if [[ "$(uname)" != "Darwin" ]]; then
	echo "⏭️ Not running on macOS, skipping"
	exit 0
fi

echo "📦 Installing .app bundle..."

# Find the first DMG in the install path.
dmg=""
while IFS= read -r file; do
	dmg="$file"
	break
done < <(find -L "$path" -maxdepth 1 -name "*.dmg" 2>/dev/null)

if [[ -z "$dmg" ]]; then
	echo "🛑 Error: no .dmg file found in $path." >&2
	exit 1
fi

echo "→ dmg=$dmg"

# Unmount the volume and clear any leftover staging dir on exit, even on error.
# A surviving backup means we died mid-swap, so put the previous bundle back.
volume=""
staging=""
backup=""
installed=""
cleanup() {
	[[ -n "$staging" && -e "$staging" ]] && rm -rf "$staging"
	if [[ -n "$backup" && -d "$backup" && -n "$installed" ]]; then
		if [[ -d "$installed" ]]; then
			rm -rf "$backup"
		else
			mv "$backup" "$installed"
		fi
	fi
	if [[ -n "$volume" ]]; then
		if ! hdiutil detach "$volume" -quiet 2>/dev/null; then
			true
		fi
	fi
}
trap cleanup EXIT

# Mount the DMG and capture the volume path from hdiutil's tab-separated output.
echo "Mounting DMG..."
while IFS=$'\t' read -r _ _ mountpoint_raw; do
	# Use read to strip leading/trailing whitespace from the field.
	read -r mountpoint <<<"$mountpoint_raw"
	if [[ "$mountpoint" == /Volumes/* ]]; then
		volume="$mountpoint"
		break
	fi
done < <(hdiutil attach "$dmg" -nobrowse)

if [[ -z "$volume" ]]; then
	echo "🛑 Error: could not determine mount point from hdiutil output." >&2
	exit 1
fi

echo "→ volume=$volume"

# Locate the .app bundle on the volume — explicit name or first found.
app_path=""
if [[ -n "$app" ]]; then
	if [[ ! -d "$volume/$app.app" ]]; then
		echo "🛑 Error: $app.app not found on volume $volume." >&2
		exit 1
	fi
	app_path="$volume/$app.app"
else
	while IFS= read -r found; do
		app_path="$found"
		break
	done < <(find "$volume" -maxdepth 1 -name "*.app" -type d 2>/dev/null)

	if [[ -z "$app_path" ]]; then
		echo "🛑 Error: no .app bundle found on volume $volume." >&2
		exit 1
	fi
fi

echo "→ app=$app_path"

# Derive the bundle filename for the destination path.
app_name="${app_path##*/}"
installed="$dest/$app_name"

# Skip when the destination already holds this version or a newer one.
# An app carrying its own updater (Sparkle, …) routinely runs ahead of the pinned release,
# so reinstalling over it would silently downgrade a working bundle.
new_version="$(bundle_version "$app_path")"
cur_version="$(bundle_version "$installed")"

if [[ "$force" == "false" && -n "$new_version" && -n "$cur_version" ]]; then
	if [[ "$new_version" == "$cur_version" ]]; then
		echo "✅ $app_name $cur_version is already installed at $dest."
		exit 0
	fi
	if version_gt "$cur_version" "$new_version"; then
		echo "⏭️ $app_name $cur_version at $dest is newer than $new_version, skipping (--force overrides)."
		exit 0
	fi
fi

# Leave a running app alone:
# the process keeps the files it already opened
# but can no longer load anything else from the bundle it was launched from,
# so the breakage surfaces later and far from the cause.
# Skip rather than fail — this runs as a postinstall hook,
# so a non-zero exit fails the whole `mise install`
# and blocks every task or git hook that auto-installs a missing tool.
# `ps` rather than `pgrep`, which does not match GUI processes launched by launchd.
if [[ "$force" == "false" ]]; then
	# shellcheck disable=SC2009  # pgrep matches neither the argv nor the name of a launchd-started GUI app
	running="$(ps -Ao comm= | grep -Fc "$installed/Contents/" || true)"
	if [[ "$running" != "0" ]]; then
		echo "⏭️ $app_name is running, leaving ${cur_version:-the installed bundle} in place."
		echo "   Quit it, then re-run with --force to install ${new_version:-the staged version}."
		exit 0
	fi
fi

# Ensure the destination directory exists.
mkdir -p "$dest"

# Install by staging a fresh copy then swapping it into place,
# so a re-install or version upgrade REPLACES the bundle instead of nesting inside it
# (`cp -R foo.app dir/foo.app` copies *into* an existing foo.app).
# `ditto` preserves bundle metadata (resource forks, ACLs) more faithfully than `cp -R`.
echo "→ dest=$installed"
staging="$dest/.${app_name}.new.$$"
backup="$dest/.${app_name}.old.$$"
rm -rf "$staging"
ditto "$app_path" "$staging"

# Drop the quarantine flag
# so the notarized bundle launches without the "downloaded from the internet" prompt.
xattr -dr com.apple.quarantine "$staging" 2>/dev/null || true

# Swap by moving the old bundle aside rather than deleting it up front,
# so a failure part-way through leaves the previous version recoverable
# instead of leaving no app at all.
# `${var:?}` guards against ever expanding toward / on an unset/empty var.
if [[ -d "${installed:?}" ]]; then
	mv "$installed" "${backup:?}"
fi
if ! mv "$staging" "$installed"; then
	echo "🛑 Error: could not move $app_name into $dest." >&2
	exit 1
fi
rm -rf "$backup"
backup=""

# --- verify -----------------------------

# Check the bundle exists AND is a real app (has Contents/) —
# the latter catches a nested or partial copy that a bare directory check would miss.
if [[ ! -d "$installed/Contents" ]]; then
	echo "🛑 Error: $app_name was not correctly installed at $dest." >&2
	exit 1
fi

echo "✅ $app_name ${new_version:-} installed to $dest."
