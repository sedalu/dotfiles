# shellcheck shell=bash
# mise/tasks/ref/_path — resolve a repo spec to its clone URL and its path under $REF_REPOS_DIR

: "${REF_REPOS_DIR:?REF_REPOS_DIR is not set — is shell/env.sh loaded?}"

# Derive <host>/<owner>/<repo> from a clone URL.
# Two shapes reach this:
# a real URL with a scheme, and git's scp-style host:path form.
# They are handled separately
# because only the scp form treats a colon as the path separator —
# swapping colons blindly would mangle the port in ssh://host:2222/owner/repo.
ref_repo_path() {
	local url="$1" rest

	if [[ $url == *://* ]]; then
		rest="${url#*://}"
		rest="${rest#*@}"
	else
		rest="${url#*@}"
		rest="${rest/://}"
	fi

	rest="${rest%.git}"
	rest="${rest%/}"

	if [[ $rest != *?/?*/?* ]]; then
		echo "fatal: cannot derive <host>/<owner>/<repo> from '$url'" >&2
		return 1
	fi

	printf '%s\n' "$rest"
}

# Expand a repo spec into a clone URL.
# Anything already carrying a scheme, or a colon ahead of the first slash (git's scp-style form),
# is a clone URL and passes through untouched.
# A bare `<host>/<owner>/<repo>` is only missing a scheme, so it gains https.
# The host is never inferred:
# the checkout path has to say who publishes the code.
ref_clone_url() {
	local spec="${1%/}"

	if [[ $spec == *://* || ${spec%%/*} == *:* ]]; then
		printf '%s\n' "$spec"
		return
	fi

	if [[ $spec != *?/?*/?* ]]; then
		echo "fatal: cannot derive a clone URL from '$spec' — expected <host>/<owner>/<repo> or a clone URL" >&2
		return 1
	fi

	printf 'https://%s\n' "$spec"
}
