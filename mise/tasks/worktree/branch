#!/usr/bin/env bash
#MISE description="Create a worktree for a new or existing remote branch"
#MISE depends=["worktree:fetch"]
#USAGE arg "<branch>" help="Branch to create, or an existing remote branch to check out"
#USAGE flag "--from <from>" help="Base branch for new branches (default: remote HEAD)"
#USAGE flag "--name <name>" help="Override the worktree directory name"
# shellcheck disable=SC2154  # usage_* vars are injected by mise from the #USAGE specs above
set -euo pipefail
# shellcheck source=SCRIPTDIR/_repo_root
source "$(dirname "$0")/_repo_root"
# shellcheck source=SCRIPTDIR/_default_branch
source "$(dirname "$0")/_default_branch"

BRANCH="${usage_branch}"

# Worktree directory name: sanitize slashes to dashes unless overridden.
NAME="${usage_name:-${BRANCH//\//-}}"

if [ -e "$ROOT/$NAME" ]; then
	echo "fatal: $ROOT/$NAME already exists" >&2
	exit 1
fi

FROM="${usage_from:-origin/$(default_branch "$MAIN")}"

# Auto-detect: track existing remote branch, or create a new one.
if git -C "$MAIN" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
	echo "Tracking existing remote branch origin/$BRANCH..."
	git -C "$MAIN" worktree add "$ROOT/$NAME" -b "$BRANCH" "origin/$BRANCH"
else
	echo "Creating new branch $BRANCH from $FROM..."
	git -C "$MAIN" worktree add "$ROOT/$NAME" -b "$BRANCH" "$FROM"
fi
