#!/usr/bin/env bash
#MISE description="Remove a worktree and prune stale references"
#USAGE arg "<name>" help="Worktree directory name to remove"
# shellcheck disable=SC2154  # usage_* vars are injected by mise from the #USAGE specs above
set -euo pipefail
# shellcheck source=SCRIPTDIR/_bare_root
source "$(dirname "$0")/_bare_root"

git -C "$BARE" worktree remove "$ROOT/${usage_name}"
mise run worktree:prune
