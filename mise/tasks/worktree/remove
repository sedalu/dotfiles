#!/usr/bin/env bash
#MISE description="Remove a worktree and delete its branch"
#MISE depends_post=["worktree:prune"]
#USAGE arg "<name>" help="Worktree directory name, or the branch name it was created from"
# shellcheck disable=SC2154  # usage_* vars are injected by mise from the #USAGE specs above
set -euo pipefail
# shellcheck source=SCRIPTDIR/_repo_root
source "$(dirname "$0")/_repo_root"

# Accept a branch name too, sanitized the same way worktree:branch names the directory.
NAME="${usage_name//\//-}"

BRANCH=$(git -C "$ROOT/$NAME" branch --show-current)

git -C "$MAIN" worktree remove "$ROOT/$NAME"

# A detached worktree (pr/) has no branch to delete.
[ -n "$BRANCH" ] || exit 0

git -C "$MAIN" branch -D "$BRANCH"
