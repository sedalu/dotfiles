#!/usr/bin/env bash
#MISE description="Fetch origin and pull all worktrees"
#MISE depends=["worktree:fetch"]
set -euo pipefail
# shellcheck source=SCRIPTDIR/_repo_root
source "$(dirname "$0")/_repo_root"

while read -r WT; do
	NAME="${WT##*/}"
	# A detached worktree (pr/) or a branch with no upstream has nothing to pull.
	if ! git -C "$WT" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
		echo "Skipping $NAME (no upstream)"
		continue
	fi
	echo "Pulling $NAME..."
	git -C "$WT" pull --ff-only 2>&1 | sed "s/^/  /"
done < <(list_worktrees)
