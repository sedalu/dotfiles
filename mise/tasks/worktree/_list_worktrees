# shellcheck shell=bash
# Defines: list_worktrees, which emits one worktree path per line.
# Sets: MAIN, ROOT (via _repo_root).
# Sourced by worktree:sync and worktree:status — not a standalone task.

# shellcheck source=SCRIPTDIR/_repo_root
source "$(dirname "$0")/_repo_root"

list_worktrees() {
	# sed rather than awk $2, so a path containing spaces survives.
	git -C "$MAIN" worktree list --porcelain | sed -n 's/^worktree //p'
}
