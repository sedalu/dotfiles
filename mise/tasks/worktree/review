#!/usr/bin/env bash
#MISE description="Switch the pr/ worktree to a given branch"
#MISE depends=["worktree:fetch"]
#USAGE arg "<branch>" help="Branch to check out in the pr/ worktree"
# shellcheck disable=SC2154  # usage_* vars are injected by mise from the #USAGE specs above
set -euo pipefail
# shellcheck source=SCRIPTDIR/_repo_root
source "$(dirname "$0")/_repo_root"

BRANCH="${usage_branch}"

# Detached throughout, so the checkout never collides with a branch another worktree holds.
if git -C "$MAIN" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
	REF="origin/$BRANCH"
else
	REF="$BRANCH"
fi

if [ -d "$ROOT/pr" ]; then
	git -C "$ROOT/pr" checkout --detach "$REF"
else
	git -C "$MAIN" worktree add --detach "$ROOT/pr" "$REF"
fi
