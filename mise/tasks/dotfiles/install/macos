#!/usr/bin/env bash
#USAGE complete "Apply macOS defaults settings"
#MISE description="Apply macOS defaults settings"
#MISE hide=true
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
	echo "⏭️  Not macOS, skipping"
	exit 0
fi

# shellcheck source=SCRIPTDIR/../../../../lib/dotfiles/macos.sh
source "$DOTFILES_DIR/lib/dotfiles/macos.sh"

echo ""
echo "🍎 Applying macOS settings..."

# --- Step 1: scalar preferences via [bootstrap.macos.defaults] ---
# Capture which write-domains mise will change *before* applying,
# so we can restart exactly those apps afterwards.
# status columns are space-padded;
# the domain is the first field and the state the last,
# so first/last extraction is robust to value spacing — no jq needed.
write_changed=()
while read -r domain; do
	[[ -n "$domain" ]] && write_changed+=("$domain")
done < <(mise bootstrap macos-defaults status 2>/dev/null | awk '$NF != "set" { print $1 }')

echo ""
echo "⚙️  Writing preferences..."
mise bootstrap macos-defaults apply --yes

# --- Step 2: reset-catalog via `defaults delete` ---
# These keys have no [bootstrap.macos.defaults] equivalent
# (mise can't express "absent"),
# so they stay as sourced `defaults delete` lines.
# Snapshot each key before and after to detect which deletes actually changed state.
_dw_domains=() _dw_keys=()
while IFS= read -r file; do
	macos_parse_defaults "$file"
done < <(macos_settings_files)

_before=()
for i in "${!_dw_domains[@]}"; do
	_before[i]="$(command defaults read "${_dw_domains[$i]}" "${_dw_keys[$i]}" 2>/dev/null || echo "")"
done

echo ""
echo "🧹 Resetting tracked defaults..."

# Wrap `defaults` to give per-line feedback while sourcing the catalog.
# A failing `defaults delete` just means the key is already absent.
defaults() {
	if command defaults "$@" 2>/dev/null; then
		echo "  ✔ ${*:2}"
	else
		echo "  ✔ ${*:2} (already default)"
	fi
}

killall_targets=()
# shellcheck source=SCRIPTDIR/../../../../macos/settings.sh
. "$DOTFILES_DIR/macos/settings.sh"

machine_file="$DOTFILES_DIR/macos/settings.${DOTFILES_MACHINE}.sh"
if [[ -f "$machine_file" ]]; then
	echo "  📎 Machine: $DOTFILES_MACHINE"
	# shellcheck source=/dev/null
	. "$machine_file"
fi

unset -f defaults

# --- Step 3: restart only the apps whose settings changed ---
delete_changed=()
for i in "${!_dw_domains[@]}"; do
	after="$(command defaults read "${_dw_domains[$i]}" "${_dw_keys[$i]}" 2>/dev/null || echo "")"
	[[ "${_before[$i]}" != "$after" ]] && delete_changed+=("${_dw_domains[$i]}")
done

_needed_targets=()
_has_target() {
	local t
	for t in "${_needed_targets[@]}"; do [[ "$t" == "$1" ]] && return 0; done
	return 1
}

for domain in "${write_changed[@]}" "${delete_changed[@]}"; do
	for entry in "${killall_targets[@]}"; do
		[[ "${entry%%:*}" == "$domain" ]] || continue
		target="${entry#*:}"
		_has_target "$target" || _needed_targets+=("$target")
	done
done

if ((${#_needed_targets[@]} > 0)); then
	echo ""
	echo "🔄 Restarting changed apps..."
	for target in "${_needed_targets[@]}"; do
		killall "$target" 2>/dev/null || true
		echo "  ↺ $target"
	done
else
	echo ""
	echo "✅ No changes detected, no restarts needed"
fi

echo ""
echo "🎉 macOS settings applied"
echo "ℹ️  Some settings may require logout or reboot to take effect"
