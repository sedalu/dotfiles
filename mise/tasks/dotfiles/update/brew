#!/usr/bin/env bash
#USAGE complete "Update Homebrew and upgrade Brewfile packages"
#MISE description="Update Homebrew and upgrade Brewfile packages"
#MISE hide=true

set -euo pipefail

# shellcheck source=lib/dotfiles/hostname.sh
source "${DOTFILES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}}/lib/dotfiles/hostname.sh"

# --- update -----------------------------

echo ""
echo "🔄 Updating Homebrew..."

brew update

# Upgrade only what the Brewfile declares (formulae + sidecar) and all casks.
# System libraries (bash, git, zsh, openssl@3, pkgconf and their transitive
# deps) are owned by mise via [system.packages]; a blanket `brew upgrade` would
# re-pour them and collide with mise's bottle manager, since both share the
# same prefix (/opt/homebrew).
echo ""
echo "⬆️  Upgrading Brewfile formulae and casks..."

brewfile="${HOMEBREW_BUNDLE_FILE:-$DOTFILES_DIR/homebrew/Brewfile}"
machine="${DOTFILES_MACHINE:-$(normalize_hostname "$(get_hostname)")}"
machine_brewfile="$(dirname "$brewfile")/Brewfile.${machine}"

formulae=()
while IFS= read -r f; do
    [[ -n $f ]] && formulae+=("$f")
done < <(brew bundle list --formula --file="$brewfile" 2>/dev/null)
if [[ -f $machine_brewfile ]]; then
    while IFS= read -r f; do
        [[ -n $f ]] && formulae+=("$f")
    done < <(brew bundle list --formula --file="$machine_brewfile" 2>/dev/null)
fi

if ((${#formulae[@]})); then
    brew upgrade "${formulae[@]}"
fi
brew upgrade --cask
brew cleanup

echo "🎉 Homebrew updated."
